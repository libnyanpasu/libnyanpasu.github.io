{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "default:disableRateLimiting",
    "default:rebaseStalePrs",
    "group:allNonMajor"
  ],
  "automerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "groupName": "Astro packages",
      "matchPackageNames": ["/astro/", "/@astrojs//"]
    },
    {
      "groupName": "React packages",
      "matchPackageNames": ["/react/", "/@types/react/"]
    },
    {
      "groupName": "TypeScript",
      "matchPackageNames": ["/typescript/"]
    },
    {
      "groupName": "Lint & Format packages",
      "matchPackageNames": ["/oxlint/", "/oxfmt/", "/commitlint/", "/husky/", "/lint-staged/"]
    },
    {
      "groupName": "Inlang packages",
      "matchPackageNames": ["/@inlang//"]
    }
  ]
}
