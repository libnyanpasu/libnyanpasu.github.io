---
import { icons as materialIcons } from "@iconify-json/material-symbols";
import { getIconData, iconToSVG } from "@iconify/utils";
import { m } from "@/paraglide/messages.js";
import type { Locale } from "@/paraglide/runtime";
import FeatureSection, { type FeatureLabels } from "./feature-section";
import { buildSchemes } from "./material-schemes";
import "./features.css";

interface Props {
  locale: Locale;
  base: string;
}

const { locale, base } = Astro.props;
const opts = { locale };

const glyph = (name: string) => {
  const svg = iconToSVG(getIconData(materialIcons, name)!);
  return { body: svg.body, viewBox: svg.attributes.viewBox };
};
// The demos use the same Material Symbols as the client.
const icons = Object.fromEntries(
  Object.entries({
    check: "check-rounded",
    close: "close-rounded",
    add: "add-rounded",
    edit: "edit-rounded",
    search: "search-rounded",
    sync: "sync-rounded",
    outward: "north-east-rounded",
    dropdown: "arrow-drop-down-rounded",
    up: "arrow-upward-rounded",
    down: "arrow-downward-rounded",
    dashboard: "dashboard-rounded",
    proxies: "public-rounded",
    grid: "grid-view-outline-rounded",
    code: "settings-ethernet-rounded",
    traffic: "schema-rounded",
    rule: "design-services-rounded",
    terminal: "terminal-rounded",
    settings: "settings-rounded",
    apps: "apps-rounded",
    lan: "lan-outline-rounded",
    devices: "devices-rounded",
    dns: "dns-rounded",
    split: "call-split-rounded",
    swap: "swap-vert-rounded",
    cable: "cable-rounded",
    route: "route-rounded",
    desktop: "install-desktop-rounded",
    memory: "memory-outline-rounded",
    cloud: "cloud-rounded",
    schedule: "schedule-rounded",
    article: "article-rounded",
    bug: "bug-report-rounded",
    info: "info-rounded",
    warning: "warning-rounded",
    error: "error-rounded",
    stop: "stop-circle-rounded",
    restart: "restart-alt-rounded",
    update: "deployed-code-update-outline-rounded",
    dark: "dark-mode-rounded",
    light: "light-mode-rounded",
    brightness: "brightness-medium-rounded",
    // Section badges.
    profiles: "account-tree-rounded",
    widgets: "dashboard-customize-rounded",
    palette: "palette-rounded",
    sparkle: "auto-awesome-rounded",
  }).map(([key, name]) => [key, glyph(name)]),
);
icons.memoryBadge = glyph("memory-rounded");
icons.trafficBadge = glyph("bar-chart-4-bars-rounded");

const t = (message: (inputs: undefined, options: typeof opts) => string) => message(undefined, opts);
// Templated strings keep their `{placeholders}`; the demos fill them in.
const tags = (value: string) =>
  value
    .split("·")
    .map((tag) => tag.trim())
    .filter(Boolean);

const labels: FeatureLabels = {
  heading: {
    title: t(m.home_rebuild_title),
    description: t(m.home_rebuild_description),
  },
  traffic: {
    title: t(m.home_traffic_title),
    description: t(m.home_traffic_description),
    tags: tags(t(m.home_traffic_tags)),
    demo: {
      rail: t(m.home_demo_traffic_rail),
      views: [
        t(m.home_demo_traffic_overview),
        t(m.home_demo_traffic_paths),
        t(m.home_demo_traffic_geography),
        t(m.home_demo_traffic_device),
        t(m.home_demo_traffic_process),
      ],
      total: t(m.home_demo_traffic_total),
      connections: t(m.home_demo_traffic_connections),
      processes: t(m.home_demo_traffic_process),
      hosts: t(m.home_demo_traffic_top_hosts),
      topProcesses: t(m.home_demo_traffic_top_processes),
      topHosts: t(m.home_demo_traffic_top_hosts),
      topRegions: t(m.home_demo_traffic_top_regions),
      topDevices: t(m.home_demo_traffic_top_devices),
      viewAll: t(m.home_demo_traffic_view_all),
      others: m.home_demo_traffic_others({ count: "{count}" }, opts),
      connectionCount: m.home_demo_traffic_connection_count({ count: "{count}" }, opts),
      scopeLabel: t(m.home_demo_traffic_scope),
      scopes: [
        t(m.home_demo_traffic_scope_all),
        t(m.home_demo_traffic_scope_active),
        t(m.home_demo_traffic_scope_closed),
      ],
      metric: t(m.home_demo_traffic_metric),
      rangeLabel: t(m.home_demo_traffic_range),
      ranges: [
        t(m.home_demo_traffic_range_24h),
        t(m.home_demo_traffic_range_7d),
        t(m.home_demo_traffic_range_30d),
      ],
      layers: t(m.home_demo_traffic_layers),
      limit: t(m.home_demo_traffic_limit),
      caption: t(m.home_demo_traffic_caption),
      removeFilter: m.home_demo_traffic_remove_filter({ filter: "{filter}" }, opts),
    },
  },
  profiles: {
    title: t(m.home_profiles_title),
    description: t(m.home_profiles_description),
    guide: t(m.home_profiles_guide),
    demo: {
      applied: m.home_demo_inspect_applied({ core: "{core}", revision: "{revision}" }, opts),
      stepsLabel: t(m.home_demo_inspect_steps),
      list: t(m.home_demo_inspect_list),
      chain: t(m.home_demo_inspect_chain),
      showAll: t(m.home_demo_inspect_show_all),
      changedFields: t(m.home_demo_inspect_fields),
      noBaseline: t(m.home_demo_inspect_no_baseline),
      noChanges: t(m.home_demo_inspect_unchanged),
      yaml: "YAML",
      diff: t(m.home_demo_inspect_diff),
      logs: t(m.home_demo_inspect_logs),
      noLogs: t(m.home_demo_inspect_no_logs),
      relative: m.home_demo_inspect_relative({ step: "{step}" }, opts),
      independent: t(m.home_demo_inspect_independent),
      steps: {
        file: t(m.home_demo_inspect_file),
        scoped: t(m.home_demo_inspect_scoped),
        filter: t(m.home_demo_inspect_filter),
        overrides: t(m.home_demo_inspect_overrides),
        includeAll: t(m.home_demo_inspect_include_all),
        builtin: t(m.home_demo_inspect_builtin),
        finalize: t(m.home_demo_inspect_finalize),
        core: t(m.home_demo_inspect_core),
      },
      profile: t(m.home_demo_profile_name),
    },
  },
  dashboard: {
    title: t(m.home_dashboard_title),
    description: t(m.home_dashboard_description),
    demo: {
      widgets: {
        down: t(m.home_demo_widget_download),
        up: t(m.home_demo_widget_upload),
        memory: t(m.home_demo_widget_memory),
        connections: t(m.home_demo_widget_connections),
        proxy: t(m.home_demo_widget_proxy),
        core: t(m.home_demo_widget_core),
        mode: t(m.home_demo_widget_mode),
        quota: t(m.home_demo_widget_quota),
        schedule: t(m.home_demo_widget_schedule),
        recent: t(m.home_demo_widget_recent),
        process: t(m.home_demo_widget_process),
        exit: t(m.home_demo_widget_exit),
        target: t(m.home_demo_widget_target),
        rule: t(m.home_demo_widget_rule),
        active: t(m.home_demo_widget_active),
        providers: t(m.home_demo_widget_providers),
      },
      addWidget: t(m.home_demo_widget_add),
      save: t(m.home_demo_widget_save),
      edit: t(m.home_demo_widget_edit),
      search: t(m.home_demo_widget_search),
      closeLibrary: t(m.home_demo_widget_close_library),
      remove: t(m.home_demo_widget_delete),
      noResults: t(m.home_demo_widget_no_results),
      total: m.home_demo_widget_total({ value: "{value}" }, opts),
      systemProxy: t(m.client_preview_system_proxy),
      tunMode: t(m.client_preview_tun_mode),
      modes: [t(m.client_preview_rule), t(m.client_preview_global), t(m.client_preview_direct)],
      running: t(m.client_preview_running),
      profile: t(m.home_demo_profile_name),
    },
  },
  material: {
    title: t(m.home_material_title),
    description: t(m.home_material_description),
    themeColor: t(m.home_demo_theme_color),
    themeMode: t(m.home_demo_theme_mode),
    modes: [t(m.home_demo_theme_dark), t(m.home_demo_theme_system), t(m.home_demo_theme_light)],
    app: {
      file: t(m.client_preview_file),
      settings: t(m.client_preview_settings),
      help: t(m.client_preview_help),
      nav: [
        t(m.client_preview_dashboard),
        t(m.client_preview_proxies),
        t(m.client_preview_profiles),
        t(m.client_preview_connections),
        t(m.client_preview_traffic),
        t(m.client_preview_rules),
        t(m.client_preview_logs),
        t(m.client_preview_settings),
        t(m.client_preview_providers),
      ],
      download: t(m.client_preview_download),
      upload: t(m.client_preview_upload),
      memory: t(m.client_preview_memory),
      connections: t(m.client_preview_connections),
      proxyStatus: t(m.client_preview_proxy_status),
      systemProxy: t(m.client_preview_system_proxy),
      tunMode: t(m.client_preview_tun_mode),
      routingMode: t(m.home_demo_routing_mode),
      rule: t(m.client_preview_rule),
      global: t(m.client_preview_global),
      direct: t(m.client_preview_direct),
      coreStatus: t(m.client_preview_core_status),
      running: t(m.client_preview_running),
      byService: t(m.client_preview_running_by_service),
    },
  },
  cores: {
    title: t(m.home_cores_title),
    description: t(m.home_cores_description),
    demo: {
      title: t(m.home_demo_cores_title),
      restart: t(m.home_demo_cores_restart),
      checkUpdates: t(m.home_demo_cores_check),
      update: t(m.home_demo_cores_update),
      restarting: t(m.home_demo_cores_restarting),
      loading: t(m.home_demo_cores_loading),
    },
  },
  logs: {
    title: t(m.home_logs_title),
    description: t(m.home_logs_description),
    demo: {
      rail: t(m.home_demo_logs_rail),
      levels: [
        t(m.home_demo_logs_all),
        t(m.home_demo_logs_trace),
        t(m.home_demo_logs_debug),
        t(m.home_demo_logs_info),
        t(m.home_demo_logs_warn),
        t(m.home_demo_logs_error),
        t(m.home_demo_logs_fatal),
      ],
      search: t(m.home_demo_logs_search),
      sourceLabel: t(m.home_demo_logs_source),
      sources: [t(m.home_demo_logs_core), t(m.home_demo_logs_app), t(m.home_demo_logs_service)],
      empty: t(m.home_demo_logs_empty),
      clear: t(m.home_demo_clear),
    },
  },
};
---

<FeatureSection client:visible labels={labels} icons={icons} schemes={buildSchemes()} base={base} />
<noscript>
  <style>
    .m3f [style*="opacity"] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  </style>
</noscript>
