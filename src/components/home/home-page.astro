---
import { m } from "@/paraglide/messages.js";
import type { Locale } from "@/paraglide/runtime";
import { createMd3ThemeOptionsCss } from "starlight-theme-md3";
import { homeBlogPosts, homeRelease, repositoryUrl } from "@/data/home";
import HomeHeader from "./home-header";
import IconifyIcon from "../iconify-icon.astro";
import { icons as logoIcons } from "@iconify-json/logos";
import { icons as materialIcons } from "@iconify-json/material-symbols";
import { icons as lucideIcons } from "@iconify-json/lucide";
import { getIconData, iconToSVG } from "@iconify/utils";
import ShaderBackdrop from "./shader-backdrop";
import Features from "./features/features.astro";
import ClientPreview from "./client-preview";
import { shapePath } from "./features/m3-shape";
import "./home-page.css";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const base = locale === "zh-cn" ? "/zh-cn" : "";
const opts = { locale };
const posts = homeBlogPosts.filter((post) => post.locale === locale);
const githubIcon = { body: logoIcons.icons["github-icon"].body.replace(/#161614/g, "currentColor"), viewBox: `0 0 ${logoIcons.icons["github-icon"].width || logoIcons.width || 16} ${logoIcons.icons["github-icon"].height || logoIcons.height || 16}` };
const navItems = [
  { label: m.home_nav_features(undefined, opts), href: "#features" },
  { label: m.home_nav_download(undefined, opts), href: "#download" },
  { label: m.home_nav_docs(undefined, opts), href: `${base}/introduction/` },
  ...(posts.length ? [{ label: m.home_nav_blog(undefined, opts), href: `${base}/blog/` }] : []),
  { label: "GitHub", href: repositoryUrl, icon: githubIcon },
];
const appIconNames: Record<string, string> = { "layout-dashboard":"dashboard-rounded", globe:"public", "layout-grid":"grid-view-outline-rounded", unplug:"settings-ethernet-rounded", wrench:"design-services-rounded", "square-terminal":"terminal-rounded", settings:"settings-rounded", grip:"apps", "arrow-down":"arrow-downward-rounded", "arrow-up":"arrow-upward-rounded", cpu:"memory-outline-rounded", network:"network-ping-rounded", traffic:"schema-rounded", mode:"route-rounded", rule:"route-rounded", global:"public-rounded", direct:"north-east-rounded", check:"check-rounded", chevron:"chevron-right-rounded", service:"desktop-windows-rounded", "system-proxy":"install-desktop-rounded" };
const previewIcons = Object.fromEntries(["layout-dashboard","globe","layout-grid","unplug","wrench","square-terminal","settings","grip","pin","minus","square","x","arrow-down","arrow-up","cpu","network","traffic","mode","rule","global","direct","check","chevron","service","system-proxy"].map(name => { const svg = iconToSVG(getIconData(appIconNames[name] ? materialIcons : lucideIcons,appIconNames[name] || name)!); return [name, {body:svg.body,viewBox:svg.attributes.viewBox}]; }));
const previewLabels = {
  runningByService: m.client_preview_running_by_service(undefined,opts),
  runningByChildProcess: m.client_preview_running_by_child_process(undefined,opts),
  childProcessShort: m.client_preview_child_process_short(undefined,opts),
  serviceShort: m.client_preview_service_short(undefined,opts),
  dashboard: m.client_preview_dashboard(undefined,opts),
  proxies: m.client_preview_proxies(undefined,opts),
  profiles: m.client_preview_profiles(undefined,opts),
  connections: m.client_preview_connections(undefined,opts),
  activeConnections: m.client_preview_active_connections(undefined,opts),
  rules: m.client_preview_rules(undefined,opts),
  logs: m.client_preview_logs(undefined,opts),
  settings: m.client_preview_settings(undefined,opts),
  providers: m.client_preview_providers(undefined,opts),
  download: m.client_preview_download(undefined,opts),
  upload: m.client_preview_upload(undefined,opts),
  memory: m.client_preview_memory(undefined,opts),
  proxyStatus: m.client_preview_proxy_status(undefined,opts),
  systemProxy: m.client_preview_system_proxy(undefined,opts),
  systemProxyShort: m.client_preview_system_proxy_short(undefined,opts),
  tunMode: m.client_preview_tun_mode(undefined,opts),
  proxyDisabled: m.client_preview_proxy_disabled(undefined,opts),
  proxyOccupied: m.client_preview_proxy_occupied(undefined,opts),
  proxyMode: m.client_preview_proxy_mode(undefined,opts),
  rule: m.client_preview_rule(undefined,opts),
  global: m.client_preview_global(undefined,opts),
  direct: m.client_preview_direct(undefined,opts),
  coreStatus: m.client_preview_core_status(undefined,opts),
  checkingCore: m.client_preview_checking_core(undefined,opts),
  running: m.client_preview_running(undefined,opts),
  stopped: m.client_preview_stopped(undefined,opts),
  serviceRunning: m.client_preview_service_running(undefined,opts),
  serviceStopped: m.client_preview_service_stopped(undefined,opts),
  serviceNotInstalled: m.client_preview_service_not_installed(undefined,opts),
  coreStoppedUnknown: m.client_preview_core_stopped_unknown(undefined,opts),
  controlChannel: m.client_preview_control_channel(undefined,opts),
  file: m.client_preview_file(undefined,opts),
  help: m.client_preview_help(undefined,opts),
  update: m.client_preview_update(undefined,opts),
  traffic: m.client_preview_traffic(undefined,opts),
  total: m.client_preview_total(undefined,opts),
  version: m.client_preview_version(undefined,opts),
  clientLabel: m.client_preview_client_label(undefined,opts),
  navLabel: m.client_preview_nav_label(undefined,opts),
  comingSoon: m.client_preview_coming_soon(undefined,opts),
};
const themeCss = createMd3ThemeOptionsCss({ seed: "#3e64a7" });
const platforms = [
  { name: "Windows", anchor: "windows", icon: "logos:microsoft-windows-icon" as const, shape: "square" as const },
  { name: "macOS", anchor: "macos", icon: "logos:apple" as const, shape: "cookie9" as const },
  { name: "Linux", anchor: "linux", icon: "flat-color-icons:linux" as const, shape: "clover4" as const },
];
---
<style is:global set:html={themeCss} />
<div class="home-site" data-home-locale={locale}>
  <a class="home-skip-link" href="#home-content">{m.home_skip_content(undefined, opts)}</a>
  <HomeHeader logoHref={base || "/"} navItems={navItems} locale={locale} client:load><slot /></HomeHeader>
  <main id="home-content" tabindex="-1">
    <div class="home-backdrop" aria-hidden="true"><ShaderBackdrop variant="hero" client:only="react" /></div>
    <section class="home-hero home-container" aria-labelledby="hero-title">
      <div class="hero-heading-row">
        <h1 id="hero-title"><span>Clash</span><span class="hero-name">Nyanpasu<span class="hero-period">.</span></span></h1>
        <div class="hero-intro"><p class="hero-positioning">{m.home_positioning(undefined, opts)}</p><p class="hero-description">{m.home_description(undefined, opts)}</p><div class="hero-actions"><a class="home-button home-button-primary" href="#download">{m.home_download_action(undefined, opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-down" /></span></a><a class="home-button home-button-secondary hero-docs" href={`${base}/introduction/`}>{m.home_read_docs(undefined, opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-up-right" /></span></a></div></div>
      </div>
      <div class="hero-showcase">
        <ClientPreview labels={previewLabels} icons={previewIcons} client:load />
      </div>
      <a class="hero-scroll home-text-link" href="#features">{m.home_scroll_hint(undefined, opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-down" /></span></a>
    </section>
    <Features locale={locale} base={base} />
    <section tabindex="-1" id="download" class="home-download" aria-labelledby="download-title">
      <div class="home-backdrop home-backdrop-download" aria-hidden="true"><ShaderBackdrop variant="download" seed={3} lazy client:only="react" /></div>
      <div class="home-container">
        <div class="download-heading">
          <div><h2 id="download-title">{m.home_download_title(undefined,opts)}</h2><p>{m.home_download_description(undefined,opts)}</p></div>
          <span class="download-version"><i aria-hidden="true"></i>{homeRelease.version}<small>{m.home_release_note(undefined,opts)}</small></span>
        </div>
        <div class="platform-list">
          {platforms.map((platform, index) => (
            <article class="platform-item" data-platform={platform.anchor} style={`--i:${index}`}>
              <span class="platform-symbol"><svg class="platform-shape" viewBox="0 0 100 100" aria-hidden="true"><path d={shapePath(platform.shape)} /></svg><IconifyIcon name={platform.icon} /></span>
              <h3>{platform.name}</h3>
              <div class="platform-actions">
                <a class="home-button home-button-tonal platform-action" href={homeRelease.href}>{m.home_platform_download({platform:platform.name},opts)}<span aria-hidden="true"><IconifyIcon name="lucide:download" /></span></a>
                <a class="platform-guide" href={`${base}/tutorial/install/#${platform.anchor}`}>{m.home_install_guide(undefined,opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-right" /></span></a>
              </div>
            </article>
          ))}
        </div>
        <div class="download-notes"><p>{m.home_platform_assets(undefined,opts)}</p><a href={`${repositoryUrl}/releases`} class="home-text-link">{m.home_other_versions(undefined,opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-up-right" /></span></a></div>
      </div>
      <script is:inline>
        (() => {
          // Lift the visitor's own platform: its download becomes the filled button.
          const ua = (navigator.userAgentData?.platform || navigator.platform || navigator.userAgent).toLowerCase();
          const os = ua.includes("win") ? "windows" : ua.includes("mac") ? "macos" : ua.includes("linux") ? "linux" : "";
          const card = os && document.querySelector(`.platform-item[data-platform="${os}"]`);
          if (card) card.dataset.current = "";
        })();
      </script>
    </section>
    {posts.length > 0 && <section class="home-blog home-container" aria-labelledby="blog-title"><div class="blog-heading"><div><h2 id="blog-title">{m.home_nav_blog(undefined,opts)}</h2><p>{m.home_blog_description(undefined,opts)}</p></div><a class="home-text-link" href={`${base}/blog/`}>{m.home_blog_all(undefined,opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-up-right" /></span></a></div><div class="blog-list">{posts.slice(0,3).map((post)=>(<article><a href={post.href}>{post.cover && <img src={post.cover} alt={post.coverAlt || ""} loading="lazy" width="640" height="360"/>}<time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString(locale === "zh-cn" ? "zh-CN":"en",{year:"numeric",month:"short",day:"numeric",timeZone:"UTC"})}</time><h3>{post.title}</h3><p>{post.description}</p></a></article>))}</div></section>}
  </main>
  <footer class="home-footer home-container"><div><a class="footer-brand" href={base || "/"}><img src="/images/logo.png" width="28" height="28" alt=""/>Clash Nyanpasu</a><p>{m.home_footer_description(undefined,opts)}</p></div><nav aria-label={locale === "zh-cn" ? "页脚导航":"Footer"}><a href="#download">{m.home_nav_download(undefined,opts)}</a><a href={`${base}/introduction/`}>{m.home_nav_docs(undefined,opts)}</a><a href={`${base}/others/faq/`}>{m.home_nav_faq(undefined,opts)}</a>{posts.length > 0 && <a href={`${base}/blog/`}>{m.home_nav_blog(undefined,opts)}</a>}<a href={repositoryUrl}><IconifyIcon name="logos:github-icon" class="source-code-icon" />{m.home_source_code(undefined,opts)}<span aria-hidden="true"><IconifyIcon name="lucide:arrow-up-right" /></span></a></nav><div class="footer-bottom"><span>© {new Date().getFullYear()} LibNyanpasu</span><span>(∠・ω&lt; )⌒☆</span><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a></div></footer>
</div>
