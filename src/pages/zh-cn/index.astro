---
import HomePage from "@/components/home/home-page.astro";
import HomeHeaderControls from "@/components/home/home-header-controls.astro";
import { m } from "@/paraglide/messages.js";
import "@/styles/tailwind.css";
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={m.home_meta_description(undefined, { locale: "zh-cn" })}
    />
    <title>Clash Nyanpasu</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="m-0 min-w-80 bg-zinc-50 font-sans dark:bg-zinc-950">
    <HomePage locale="zh-cn">
      <HomeHeaderControls locale="zh-cn" />
    </HomePage>
  </body>
</html>
