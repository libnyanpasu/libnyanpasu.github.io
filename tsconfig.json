{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    // Generated by `astro sync`; required to resolve virtual modules like `astro:content` with plain `tsc`.
    ".astro/types.d.ts",
    "src",
    "scripts/**/*.ts",
    "astro.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
